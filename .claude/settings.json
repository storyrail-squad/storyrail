{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/storyrail-status.mjs:*)",
      "Bash(node scripts/storyrail-dashboard.mjs:*)",
      "Bash(node scripts/storyrail-workspace.mjs:*)",
      "Bash(node scripts/storyrail-eval.mjs:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm audit:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(mvn -B:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue comment:*)",
      "Bash(semgrep:*)",
      "Bash(gitleaks:*)",
      "Bash(osv-scanner:*)",
      "Bash(curl -fs:*)",
      "Bash(lsof:*)",
      "Bash(diff:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./evals/hidden/**)",
      "Bash(cat evals/hidden:*)",
      "Bash(cat ./evals/hidden:*)"
    ]
  }
}
